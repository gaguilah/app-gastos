{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full",
    "IMPECCABLE_LIVE_COPY_AGENT": "chat"
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": { "source": "github", "repo": "pbakaus/impeccable" }
    },
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "enabledPlugins": {
    "impeccable@impeccable": true,
    "ponytail@ponytail": true
  },
  "permissions": {
    "ask": [
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase secrets set:*)",
      "Bash(supabase projects:*)",
      "Bash(netlify deploy --prod:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_edge_function_secret",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__create_project"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/formatear-y-validar.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
